# Express API (the /server folder). Defaults to http://localhost:5000/api in dev
# and the Render deployment in production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL of this site, used for canonical links, the sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gemini-powered features (AI refine, chat, ATS audit, cover letter, import).
# Keep "false" until the server has a working GEMINI_API_KEY.
NEXT_PUBLIC_AI_ENABLED=false

# Contact address shown on the privacy policy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional banner text on the marketing pages (e.g. maintenance notices).
# NEXT_PUBLIC_ANNOUNCEMENT=

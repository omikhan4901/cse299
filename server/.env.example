PORT=5000
MONGO_URI=mongodb://localhost:27017/resumex_db
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
NODE_ENV=development

# Optional: comma-separated list of allowed front-end origins (CORS). Open when unset.
# CLIENT_ORIGIN=https://your-site.vercel.app,http://localhost:3000

# AI (Google Gemini). AI routes stay off without a key; set AI_ENABLED=false to force them off.
# Get a free key at https://aistudio.google.com (use a project with no billing account attached).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Used automatically when the main model is overloaded or rate-limited:
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# AI_ENABLED=false

# Optional: where the "How to Write a Good Resume" guide lives (defaults to ../shared/resume-guide.md).
# Set it if you deploy the server folder on its own.
# RESUME_GUIDE_PATH=/app/shared/resume-guide.md

# --- Security ---
# JWT_SECRET must be at least 32 random characters in production: `openssl rand -hex 32`
# Set when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limits see real IPs.
# TRUST_PROXY=1

# --- Limits (per account) ---
# AI_RATE_PER_MINUTE=8
# AI_DAILY_LIMIT=40          # free accounts, per UTC day (a PDF import costs 3, a cover letter 2)
# AI_DAILY_LIMIT_PRO=300     # accounts with plan "pro"
# MAX_RESUMES_PER_ACCOUNT=50

# --- Email (password reset links) ---
# Without SMTP_URL, development prints reset links to the console and production turns resets off.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
# MAIL_FROM=ResumeX <no-reply@yourdomain.com>
# Public site address used in emailed links (defaults to the first CLIENT_ORIGIN).
# APP_URL=https://yourdomain.com

# --- Admin console ---
# Emails of super admins (comma-separated). They can open /admin, change plans,
# prices and credit costs, manage users and campaigns, and make other people admins.
# SUPERADMIN_EMAILS=you@example.com
